# PostgreSQL connection string used by Prisma and the API.
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

# Use a long, random value (at least 32 characters) in every environment.
JWT_SECRET="change-me-to-a-random-secret-at-least-32-characters-long"

# Token lifetime, e.g. 60m, 12h, 7d.
JWT_EXPIRES_IN="1d"

# bcrypt cost factor (4-15). Lower only for local tests.
BCRYPT_ROUNDS=12

NODE_ENV="development"
PORT=3000

# Comma-separated list of allowed browser origins, or "*" for all.
CORS_ORIGIN="http://localhost:5173"
